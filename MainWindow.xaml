<Window x:Class="QuotaWisp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuotaWisp"
        Title="Quota Wisp" Width="360" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DigitalProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#FF111B2B" />
            <Setter Property="Foreground" Value="#FF3BE6F8" />
            <Setter Property="BorderBrush" Value="#FF27465A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track" Margin="1" ClipToBounds="True">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="1" RadiusY="1">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#FF42E8FA" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Canvas x:Name="EffectsCanvas" IsHitTestVisible="False" />
        <Grid x:Name="PetSurface" Width="300" Height="300"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MouseEnter="Pet_MouseEnter" MouseLeave="Pet_MouseLeave"
              MouseLeftButtonDown="Pet_MouseLeftButtonDown"
              MouseLeftButtonUp="Pet_MouseLeftButtonUp"
              MouseMove="Pet_MouseMove" MouseRightButtonUp="Pet_MouseRightButtonUp">
            <Canvas x:Name="OrbitCanvas" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="OrbitRotate" />
                </Canvas.RenderTransform>
                <Canvas x:Name="SatelliteLeft" Width="36" Height="24" Canvas.Left="20" Canvas.Top="138"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="SatelliteLeftScale" /></Canvas.RenderTransform>
                    <Rectangle Width="10" Height="9" Canvas.Left="13" Canvas.Top="8" RadiusX="2" RadiusY="2"
                               Fill="#FFE8F3FF" Stroke="#FF334A86" StrokeThickness="1" />
                    <Rectangle Width="11" Height="8" Canvas.Left="0" Canvas.Top="8.5" Fill="#FF2778D8" Stroke="#FF72D7FF" StrokeThickness="1" />
                    <Rectangle Width="11" Height="8" Canvas.Left="25" Canvas.Top="8.5" Fill="#FF2778D8" Stroke="#FF72D7FF" StrokeThickness="1" />
                    <Line X1="18" Y1="8" X2="18" Y2="3" Stroke="#FFDDEBFF" StrokeThickness="1.5" />
                    <Ellipse Width="3" Height="3" Canvas.Left="16.5" Canvas.Top="0" Fill="#FFFFC65C" />
                </Canvas>
                <Canvas x:Name="SatelliteRight" Width="34" Height="26" Canvas.Left="242" Canvas.Top="110"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SatelliteRightScale" />
                            <RotateTransform Angle="-18" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle Width="10" Height="10" Canvas.Left="12" Canvas.Top="8" RadiusX="2" RadiusY="2"
                               Fill="#FFF0ECFF" Stroke="#FF58428E" StrokeThickness="1" />
                    <Rectangle Width="10" Height="8" Canvas.Left="0" Canvas.Top="9" Fill="#FF654CCB" Stroke="#FFC0AEFF" StrokeThickness="1" />
                    <Rectangle Width="10" Height="8" Canvas.Left="24" Canvas.Top="9" Fill="#FF654CCB" Stroke="#FFC0AEFF" StrokeThickness="1" />
                    <Line X1="17" Y1="8" X2="21" Y2="3" Stroke="#FFE6E0FF" StrokeThickness="1.5" />
                    <Ellipse Width="4" Height="4" Canvas.Left="20" Canvas.Top="0" Fill="#FFFFC65C" />
                </Canvas>
                <Canvas x:Name="SatelliteTop" Width="28" Height="31" Canvas.Left="144" Canvas.Top="23"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="SatelliteTopScale" /></Canvas.RenderTransform>
                    <Rectangle Width="10" Height="10" Canvas.Left="9" Canvas.Top="11" RadiusX="2" RadiusY="2"
                               Fill="#FFE9F8FF" Stroke="#FF315A86" StrokeThickness="1" />
                    <Rectangle Width="8" Height="10" Canvas.Left="0" Canvas.Top="11" Fill="#FF2A83B8" Stroke="#FF74DBF5" StrokeThickness="1" />
                    <Rectangle Width="8" Height="10" Canvas.Left="20" Canvas.Top="11" Fill="#FF2A83B8" Stroke="#FF74DBF5" StrokeThickness="1" />
                    <Line X1="14" Y1="11" X2="14" Y2="5" Stroke="#FFE5F7FF" StrokeThickness="1.5" />
                    <Path Data="M 9,5 Q 14,0 19,5" Stroke="#FFE5F7FF" StrokeThickness="1.5" Fill="Transparent" />
                </Canvas>
            </Canvas>
            <Image x:Name="WispImage" Source="Assets/quota-wisp.png" Width="176" Height="176"
                   Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                   AutomationProperties.Name="Lunar Codex quota pet">
                <Image.Effect>
                    <DropShadowEffect Color="#FFFFFFFF" BlurRadius="9" ShadowDepth="0" Opacity="0.3" />
                </Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WispScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="WispBob" />
                    </TransformGroup>
                </Image.RenderTransform>
                <Image.ToolTip>
                    <ToolTip x:Name="QuotaToolTip" Placement="Top" HorizontalOffset="0" VerticalOffset="-8"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Opened="QuotaToolTip_Opened">
                        <Border x:Name="TooltipBorder" Padding="0" CornerRadius="12" Background="#FA07111E"
                                BorderBrush="#FF42DFF4" BorderThickness="2" MinWidth="292">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="14,11,14,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="6" Height="6" Fill="#FF52F2FF" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FF52F2FF" BlurRadius="8" ShadowDepth="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="AvailableLabel" Grid.Column="1" Foreground="#FF8FEAF5"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="ModeBadge" Grid.Column="2" Background="#FF153149"
                                            BorderBrush="#FF2B6275" BorderThickness="1"
                                            CornerRadius="4" Padding="8,3" Margin="18,0,0,0">
                                        <TextBlock x:Name="ModeText" Foreground="#FFE9FBFF" FontFamily="Consolas"
                                                   FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Height="1" Background="#FF173D4B" />

                                <Grid Grid.Row="2" Margin="14,10,14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PrimaryPercent" Grid.Row="0" Foreground="#FFF4FDFF"
                                               FontFamily="Consolas" FontSize="38" FontWeight="Bold" />
                                    <ProgressBar x:Name="PrimaryProgress" Grid.Row="1" Style="{StaticResource DigitalProgressBar}"
                                                 Minimum="0" Maximum="100" Margin="0,4,0,8" />
                                    <TextBlock x:Name="PrimaryReset" Grid.Row="2" Foreground="#FF829AA8"
                                               FontFamily="Consolas" FontSize="11" />
                                </Grid>

                                <Border x:Name="SecondarySeparator" Grid.Row="3" Margin="14,0" Padding="10,8"
                                        Background="#AA0D1B2B" BorderBrush="#FF1D3B4A" BorderThickness="1"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <Grid x:Name="SecondaryPanel">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SecondaryLabel" Foreground="#FF91AAB7" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock x:Name="SecondaryPercent" Grid.Column="1" Foreground="#FFFFC75A"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold" />
                                        </Grid>
                                        <TextBlock x:Name="SecondaryReset" Foreground="#FF647D8A" FontFamily="Consolas"
                                                   FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="4" Margin="14,9,14,12">
                                    <Border x:Name="HistoryPanel" Background="#66091420" BorderBrush="#FF173B49"
                                            BorderThickness="1" CornerRadius="5" Padding="8,7" Margin="0,0,0,2">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="HistoryLabel" Foreground="#FF7898A6" FontFamily="Consolas"
                                                           FontSize="10" FontWeight="Bold" />
                                                <TextBlock x:Name="HistorySummary" Grid.Column="1" Foreground="#FF69E8F5"
                                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Right" Margin="10,0,0,0" />
                                            </Grid>
                                            <local:QuotaHistoryChart x:Name="HistoryChart" Height="62" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="ConnectionText" Foreground="#FFFF7188" FontFamily="Consolas"
                                               FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ToolTip>
                </Image.ToolTip>
            </Image>
        </Grid>
    </Grid>
</Window>
